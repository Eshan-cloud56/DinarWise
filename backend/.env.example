DINARWISE_ENVIRONMENT=development
DINARWISE_DATABASE_URL=sqlite+aiosqlite:///./dinarwise.db
DINARWISE_OPENAI_API_KEY=
DINARWISE_CORS_ORIGINS=["http://localhost:3000"]

# --- Local receipt AI (self-hosted, nothing leaves your machine) ---
# Set to false to disable AI capture entirely; manual entry keeps working.
DINARWISE_AI_CAPTURE_ENABLED=true
# Where Ollama is listening. Leave as-is if you run Ollama on this machine.
DINARWISE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Vision model used to read receipts. scripts/setup_ai_demo.sh sets this for you.
#   qwen2.5vl:7b        best Arabic + English accuracy, needs ~6 GB free RAM/VRAM
#   qwen2.5vl:3b        lighter, still bilingual, ~3 GB
#   minicpm-v           fallback if the qwen tags are unavailable
DINARWISE_OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Raise this if you are on CPU only, where a receipt can take a few minutes.
DINARWISE_OLLAMA_TIMEOUT_SECONDS=180
DINARWISE_RECEIPT_MAX_EDGE_PIXELS=1400
DINARWISE_ENABLE_DEMO_PAGE=true
